# Base URL of your TeslaMateApi instance (no trailing slash, no /api suffix).
# This is read server-side only — by the Vite dev proxy locally and by nginx
# in the built image — so the token below never ships inside browser JS.
TESLAMATE_API_URL=http://192.168.50.8:8080

# Bearer token for TeslaMateApi (API_TOKEN in its own .env). Leave blank if
# the API has API_TOKEN_DISABLE=true.
API_TOKEN=

# Set to "true" to omit the Authorization header entirely, matching
# TeslaMateApi's own API_TOKEN_DISABLE=true.
API_TOKEN_DISABLE=false
