server {
    listen 80;
    server_name _;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml font/woff2;
    gzip_min_length 1024;

    root /usr/share/nginx/html;
    index index.html;

    # Hashed build assets can be cached forever; index.html must never be,
    # or a browser keeps the old bundle after a redeploy.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # No backend of its own — proxy straight to TeslaMateApi and attach the
    # bearer token here, so it never ships inside the browser bundle. Same
    # role as the Vite dev proxy (vite.config.ts) in local development.
    location /api/ {
        proxy_pass ${TESLAMATE_API_URL};
        proxy_set_header Host $proxy_host;
        proxy_set_header Authorization "Bearer ${API_TOKEN}";
        proxy_connect_timeout 10s;
        proxy_read_timeout 15s;
    }

    location / {
        try_files $uri /index.html;
    }
}
