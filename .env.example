# Copy to .env and edit, or set these in Portainer's stack "Environment variables" box.

# Host port the app is reachable on: http://<nas-ip>:<WRAP_PORT>
WRAP_PORT=8095

# Folder on the NAS where saved wraps are written.
#   QNAP     /share/Docker/tesla-wrap-studio/wraps
#   Synology /volume1/docker/tesla-wrap-studio/wraps
#   Unraid   /mnt/user/appdata/tesla-wrap-studio/wraps
WRAPS_PATH=/share/Docker/tesla-wrap-studio/wraps
